APP_NAME=Capstone
DEBUG=true

POSTGRES_USER=[username]
POSTGRES_PASSWORD=[16 byte hex]
POSTGRES_DB=capstone
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://[user]:[password]@db:5432/capstone
TEST_DATABASE_URL=postgresql+asyncpg://[user]:[password]@db_test:5432/capstone_test

RESEND_API_KEY=mockkey123
# Dev: log emails (with links) to the backend console instead of sending via
# Resend. Set false + a real RESEND_API_KEY (re_...) to send for real.
EMAIL_CONSOLE_MODE=true
EMAIL_FROM=admin@test.com
FRONTEND_ORIGIN=http://localhost:4200
COURSE_INVITE_EXPIRE_SECONDS=604800
FRONTEND_PASSWORD_RESET_URL=http://localhost:4200/reset-password
PASSWORD_RESET_EXPIRE_SECONDS=10000
# Expiry for the set-password link emailed to admin-created accounts (72h).
ACCOUNT_ACTIVATION_EXPIRE_SECONDS=259200

# Local Canvas integration (run make canvas-setup from the repository root)
CANVAS_PUBLIC_BASE_URL=http://localhost:6700
CANVAS_API_BASE_URL=http://host.docker.internal:6700
CANVAS_TOKEN_ENCRYPTION_SECRET=[32 byte hex]
CANVAS_STUDENT_ACCESS_TOKEN_EXPIRE_SECONDS=604800
CANVAS_HTTP_TIMEOUT_SECONDS=10
CANVAS_OPERATION_TIMEOUT_SECONDS=60
CANVAS_BATCH_CONCURRENCY=5

OMR_HOST=omr_service
OMR_PORT=3000
OMR_VERSION=v1
OMR_MODE=DEVELOPMENT

GARAGE_ACCESS_KEY_ID="GK................"
GARAGE_SECRET_ACCESS_KEY="..."
GARAGE_ENDPOINT_URL="http://garage-store:3900"
GARAGE_PUBLIC_ENDPOINT_URL="http://localhost:3900"
GARAGE_REGION="garage"
GARAGE_BUCKET_NAME="capstone-storage"

JWT_ACCESS_SECRET=[32 byte hex]
JWT_REFRESH_SECRET=[32 byte hex] 
JWT_ACCESS_EXPIRE_SECONDS=1800
JWT_REFRESH_EXPIRE_SECONDS=1209600
