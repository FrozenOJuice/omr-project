# Canvas runtime
COMPOSE_PROJECT_NAME=capstone-canvas
CANVAS_IMAGE=capstone-canvas:2026-05-20.143
CANVAS_LMS_REF=release/2026-05-20.143
CANVAS_LMS_SHA=2e2b4a46d08e32667d4845f7b78e1214250345d3
CANVAS_PORT=6700
CANVAS_HOST=localhost:6700
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=10
POSTGRES_USER=canvas
POSTGRES_PASSWORD=canvas-local-password
POSTGRES_DB=canvas_production
CANVAS_ENCRYPTION_KEY=generate-me
CANVAS_JWT_ENCRYPTION_KEY=generate-me

# Initial Canvas account
CANVAS_LMS_ACCOUNT_NAME="Capstone Canvas Test"
CANVAS_LMS_ADMIN_EMAIL=admin@canvas.test
CANVAS_LMS_ADMIN_PASSWORD=Password123!
CANVAS_LMS_STATS_COLLECTION=opt_out

# Local test data
CANVAS_PROFESSOR_NAME="Avery Brooks"
CANVAS_PROFESSOR_EMAIL=empty.prof@example.com
CANVAS_PROFESSOR_SIS_ID=professor-001
CANVAS_TEST_PASSWORD=Password123!
CANVAS_API_TOKEN=generate-me
